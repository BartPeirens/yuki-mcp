{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet: build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/YukiMcp.slnx"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish: single-file exe -> /build",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/publish.ps1"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "package: zip exe + README -> /dist",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/package-zip.ps1"
            ],
            "detail": "Also (re)publishes the exe first - package-zip.ps1 calls publish.ps1 itself, so this task does not depend on 'publish: single-file exe -> /build' separately.",
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
