<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>YukiMcp</RootNamespace>
    <AssemblyName>YukiMcp</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Distribution: this server is shipped to end users as a single .exe that Claude Desktop
      launches directly (see README.md / plan.md). These settings make `dotnet publish` produce
      one self-contained, single-file executable per platform without extra flags.
      `scripts/publish.ps1` picks the runtime identifier per target at publish time; the
      RuntimeIdentifiers list below just declares which platforms are supported.
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Generated by dotnet-svcutil (see Yuki/<Service>/<Service>Client.cs); it defaulted to the
      full WCF client package set, but every generated client only ever builds a BasicHttpBinding
      or an HTTPS CustomBinding (SOAP 1.1 / SOAP 1.2 - see GetBindingForEndpoint in any generated
      file), so NetTcp/Duplex/Federation are trimmed - they'd only add dead weight to the
      single-file exe.
    -->
    <PackageReference Include="System.ServiceModel.Http" Version="4.10.3" />
    <PackageReference Include="System.ServiceModel.Security" Version="4.10.3" />
  </ItemGroup>
</Project>